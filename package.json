{
  "name": "shop-pricing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "parity:record": "node parity/record.mjs",
    "parity:check": "node parity/check.mjs",
    "parity:contract": "node parity/contract.mjs",
    "parity:diff": "node parity/diff/diff.mjs",
    "parity:traps": "node parity/traps.mjs",
    "blackbox": "node parity/blackbox/run.mjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
